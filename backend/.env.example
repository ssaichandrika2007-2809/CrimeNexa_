# Which LLM powers entity/relationship extraction: "anthropic" or "groq"
LLM_PROVIDER=anthropic

# Needed if LLM_PROVIDER=anthropic — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Needed if LLM_PROVIDER=groq — get a free-tier key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

PORT=5000
